						<Item class="Script" referent="RBXe37ffa3d4f0f4640837eab8e58a7114c">
							<Properties>
								<ProtectedString name="Source">a = false
s = script.Parent
u = s.Up:GetChildren()
d = s.Down:GetChildren()

function change(o,t)
	print("Changing...")
	if o then
		if t then
			for _,i in pairs(u) do i.Transparency = 1 end
			for _,i in pairs(d) do i.Transparency = 0 end 
			change(true,false) 
		else 
			for _,i in pairs(u) do if i:FindFirstChild("Decal") then i.Decal.Transparency = 1 end end 
			for _,i in pairs(d) do if i:FindFirstChild("Decal") then i.Decal.Transparency = 0 end end 
		end 
	else 
		if t then 
			for _,i in pairs(u) do i.Transparency = 0 end 
			for _,i in pairs(d) do i.Transparency = 1 end 
			change(false,false) 
		else 
			for _,i in pairs(u) do if i:FindFirstChild("Decal") then i.Decal.Transparency = 0 end end 
			for _,i in pairs(d) do if i:FindFirstChild("Decal") then i.Decal.Transparency = 1 end end 
		end 
	end 
end

script.Parent.Reset.Touched:connect(function(hit)
--print("Reset")
if hit.Parent == nil then return end
if hit.Parent.Name ~= "ResetKey" then return end
if not a then return end
a = false
s.Alarm.Value = false
change(false,true)
end)

script.Parent.CD.ClickDetector.MouseClick:connect(function()
--print("Clicked")
if a then return end
change(true,true)
a = true
s.Alarm.Value = true
end)
