					<Item class="Script" referent="RBX597e88f9c2d2437fa077ed359bf91fc2">
						<Properties>
							<ProtectedString name="Source">coding = script.Parent.VisualCoding

vis = script.Parent.VisualCircuit

wait(0.1)

if coding.Value == 0 then -- Continuous
vis.Value = 1
elseif coding.Value == 1 then -- 60hz StrobeSync
while true do
vis.Value = 1
wait(0.5)
vis.Value = 0
wait(0.5)
end
elseif coding.Value == 2 then -- 120bpm March Time
while true do
vis.Value = 1
wait(0.25)
vis.Value = 0
wait(0.25)
end
end</ProtectedString>
