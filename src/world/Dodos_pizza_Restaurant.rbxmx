							<Item class="Script" referent="RBXdd709d3275d04d8791cbcd4fce3603a3">
								<Properties>
									<ProtectedString name="Source">function KeyHoleTouched(hit)
	if hit.Parent.Name == "RFT Panel Key" then
		local c = script.Parent:GetChildren()
		if script.Parent.DPart.Transparency ~= 1 then
			for i = 1, #c do
				if c[i].Name == "DPart" or c[i].Name == "DPart2" then
					c[i].Transparency = 1
					c[i].CanCollide = false
				elseif c[i].Name == "DPart3" then
					c[i].Decal.Transparency = 1
				end
			end
		else
			for i = 1, #c do
				if c[i].Name == "DPart" then
					c[i].Transparency = 0
					c[i].CanCollide = true
				elseif c[i].Name == "DPart2" then
					c[i].Transparency = 0.9
					c[i].CanCollide = true
				elseif c[i].Name == "DPart3" then
					c[i].Decal.Transparency = 0
				end
			end
		end		
	end
end

script.Parent.Keyhole.Touched:connect(	KeyHoleTouched)		
</ProtectedString>
