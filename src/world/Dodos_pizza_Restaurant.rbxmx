									<Item class="Script" referent="RBXf756b7dff56f4d9ea42656403dfd715c">
										<Properties>
											<ProtectedString name="Source">
val = script.Parent.Parent.Parent.Parent.AudibleCircuit
horn = script.Parent.horn

alarm = false

horn.Pitch = math.random(72,100)/102

function Sound()
	if val.Value == 1 then
	horn:Play()
	else
	wait(0.03)
	horn:Stop()
	end
end

val.Changed:connect(Sound)

</ProtectedString>
