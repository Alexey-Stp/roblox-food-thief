											<Properties>
												<ProtectedString name="Source">system = script.Parent.Parent.Parent
coder = script.Parent.Parent.Parent.Coder
nac = script.Parent
dt = nil
tr = false

coder.AudibleCircuit.Changed:connect(function()
	if nac.Enabled.Value == true then
		nac.AudibleCircuit.Value = coder.AudibleCircuit.Value
	end
end)

coder.VisualCircuit.Changed:connect(function()
	if nac.Enabled.Value == true then
		nac.VisualCircuit.Value = coder.VisualCircuit.Value
	end
end)

nac.Enabled.Changed:connect(function()
	if nac.Enabled.Value == true then
		nac.AudibleCircuit.Value = coder.AudibleCircuit.Value
		nac.VisualCircuit.Value = coder.VisualCircuit.Value
		if dt~=nil then
			dt:Remove()
			dt = nil
		end
	else
		nac.AudibleCircuit.Value = 0
		nac.VisualCircuit.Value = 0
		local tfile = Instance.new("Model")
		local idfile = Instance.new("StringValue")
		local condfile = Instance.new("StringValue")
		tfile.Name = nac.DeviceName.Value
		idfile.Name = "ID"
		idfile.Value = tostring(nac.Name)
		idfile.Parent = tfile
		condfile.Name = "Condition"
		condfile.Value = "Disabled"
		condfile.Parent = tfile
		tfile.Parent = system.Troubles
		dt = tfile
	end
end)

nac.Speakers.DescendantRemoving:connect(function(rem)
	if tr then return end
	if rem.Name == "Audio" then return end
	local tfile = Instance.new("Model")
	local idfile = Instance.new("StringValue")
	local condfile = Instance.new("StringValue")
	tfile.Name = nac.DeviceName.Value
	idfile.Name = "ID"
	idfile.Value = tostring(nac.Name)
	idfile.Parent = tfile
	condfile.Name = "Condition"
	condfile.Value = "Damaged"
	condfile.Parent = tfile
	tfile.Parent = system.Troubles
	tr = true
end)

nac.OtherSignals.DescendantRemoving:connect(function()
	if tr then return end
	local tfile = Instance.new("Model")
	local idfile = Instance.new("StringValue")
	local condfile = Instance.new("StringValue")
	tfile.Name = nac.DeviceName.Value
	idfile.Name = "ID"
	idfile.Value = tostring(nac.Name)
	idfile.Parent = tfile
	condfile.Name = "Condition"
	condfile.Value = "Damaged"
	condfile.Parent = tfile
	tfile.Parent = system.Troubles
	tr = true
end)
</ProtectedString>
