									<Item class="Script" referent="RBXaba7a413b7a94247b2e913bcfd632f50">
										<Properties>
											<ProtectedString name="Source">while true do
wait(math.random(0.100,1))
if script.Parent.Parent.Parent.Parent.AudibleCircuit.Value ~= 0 then
wait(1.25)
script.Parent.Flasher.Strobe.Visible = false
script.Parent.Parent.Vis.Transparency=0
script.Parent.Light.Enabled = true
wait()
script.Parent.Parent.Vis.Transparency=1
script.Parent.Material = "Ice"
script.Parent.BrickColor = BrickColor.new("Smoky grey")
script.Parent.Light.Enabled = false
script.Parent.Flasher.Strobe.Visible = false
end
end</ProtectedString>
