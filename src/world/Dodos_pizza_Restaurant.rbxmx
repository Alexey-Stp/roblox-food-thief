				<Item class="Script" referent="RBX62563137928f44c5a9b3170247852b21">
					<Properties>
						<ProtectedString name="Source">id = script.Parent.SoundCont

function Silence()
if script.Parent.Silence.Value == true or script.Parent.Reset.Value == true then
local ch = script:GetChildren()
for i = 1, #ch do
ch[i].Disabled = true
end
wait()
local v = Instance.new("IntValue")
v.Name = "Stop"
v.Parent = id.Parent.SpeakerController
end
end

script.Parent.Silence.Changed:connect(Silence)
script.Parent.Reset.Changed:connect(Silence)

function PushSound()
if id.Value == "" then return end

if script.Parent.Reset.Value == true then
	id.Value = ""
return end	

	local ch = script:GetChildren()
	for i = 1, #ch do
	ch[i].Disabled = true
	end
	wait()
	local v = Instance.new("IntValue")
	v.Name = "Stop"
	v.Parent = id.Parent.SpeakerController
	wait()

if script:findFirstChild(id.Value)~=nil then
	script:findFirstChild(id.Value).Disabled = false
end

id.Value = ""
end

id.Changed:connect(PushSound)

function Cleanup(newChild)
	wait(1)
	newChild:Remove()
end

script.Parent.SpeakerController.ChildAdded:connect(Cleanup)
