					<Item class="Script" referent="RBX587ec44092ea48cfb2c7f9bcb661abfd">
						<Properties>
							<ProtectedString name="Source">function AlarmedDevice()
local c = script.Parent.IDC:GetChildren()
alarm = false
	for i = 1, #c do
		if c[i].Alarm.Value == true then alarm = true end
	end
	script.Parent.Alarm.Value = alarm
end

local d = script.Parent.IDC:GetChildren()

for i = 1, #d do
	d[i].Alarm.Changed:connect(AlarmedDevice)
end
</ProtectedString>
