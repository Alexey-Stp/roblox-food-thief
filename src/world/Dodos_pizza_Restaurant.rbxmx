									<Item class="Script" referent="RBXef91bb4096484ebfabfd80548fabb844">
										<Properties>
											<ProtectedString name="Source">
val = script.Parent.Parent.Parent.Parent.AudibleCircuit
horn = script.Parent.horn

alarm = false

function Sound()
	if val.Value == 1 then
	horn:Play()
	script.Parent.Parent.Gong_Hitter.Script.Disabled = false
	else
	wait(0.03)
	script.Parent.Parent.Gong_Hitter.Script.Disabled = true
	script.Parent.Parent.Gong_Hitter.Gong_Hitter1.Transparency = 0
	script.Parent.Parent.Gong_Hitter.Gong_Hitter2.Transparency = 1
	script.Parent.Stop:Play()
	wait(0.1)
	horn:Stop()
	end
end

val.Changed:connect(Sound)

</ProtectedString>
